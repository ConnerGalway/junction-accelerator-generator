# Junction Editor - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (same as main project)
NEXT_PUBLIC_SUPABASE_URL=https://weyugmllkettrshtrmug.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# For server-side operations (API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key (for AI image generation with DALL-E 3)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
