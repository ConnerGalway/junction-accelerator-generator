# Junction Accelerator Generator - Environment Variables
# Copy this file to .env and fill in your values
# These variables must also be configured in Netlify Dashboard → Site Settings → Environment Variables

# ===================
# REQUIRED VARIABLES
# ===================

# Supabase Configuration
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GitHub Configuration
# Used for committing project files to the repository
GITHUB_OWNER=your-github-username
GITHUB_REPO=junction-accelerator-generator
GITHUB_TOKEN=your-github-personal-access-token

# Anthropic API Key (assessment narrative generation)
# Used by: generate-assessment-background, regenerate-assessment-background
ANTHROPIC_API_KEY=your-anthropic-api-key

# SEOptimer API Key (website audits during assessments)
# Used by: generate-assessment-background, regenerate-assessment-background
SEOPTIMER_API_KEY=your-seoptimer-api-key

# ===================
# OPTIONAL VARIABLES
# ===================

# Git branch for commits (defaults to 'main' if not set)
GITHUB_BRANCH=main

# Resend API Key (for sending email invitations)
# Get yours at: https://resend.com
RESEND_API_KEY=your-resend-api-key

# Google Places API Key (business reviews/location data in assessments)
# Assessments degrade gracefully without it
GOOGLE_PLACES_KEY=your-google-places-api-key

# SociaVault API Key (social media stats in assessments)
# Assessments degrade gracefully without it
SOCIAVAULT_API_KEY=your-sociavault-api-key

# Verbose logging in assessment functions (set to any value to enable)
# DEBUG=1

# ============================================
# SUPABASE EDGE FUNCTIONS (set in Supabase Dashboard, NOT Netlify)
# Dashboard -> Edge Functions -> Secrets
# ============================================
# Required by send-monday-email and send-friday-email:
#   SUPABASE_URL                (same value as above)
#   SUPABASE_SERVICE_ROLE_KEY   (same value as above)
#   MAILERSEND_API_KEY          (weekly client emails)
